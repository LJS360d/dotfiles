# ~/.zshrc — thin entrypoint. Edit the pieces in ~/.config/zsh/, plugins in ~/.config/sheldon/plugins.toml
# Everything slow (plugin loader, prompt, mise, zoxide, fzf) is cached + zcompiled; caches refresh themselves.

typeset -U path fpath
path=(~/.local/bin $path)

ZDOTDIR_CFG=${XDG_CONFIG_HOME:-~/.config}/zsh
ZCACHE=${XDG_CACHE_HOME:-~/.cache}/zsh
[[ -d $ZCACHE ]] || mkdir -p $ZCACHE

# source file, (re)compiling to .zwc when stale (zsh auto-prefers fresh .zwc)
_zsrc() {
  [[ -r $1 ]] || return
  [[ $1.zwc -nt $1 ]] || zcompile $1
  source $1
}

# cache output of `<cmd> <args>` as <name>.zsh, rebuild when the binary changes
_zcache() {
  local name=$1 bin=${commands[$2]} f=$ZCACHE/$1.zsh; shift
  [[ -n $bin ]] || return
  # failed command -> no cache, so its error shows again next shell instead of a silent empty cache
  if [[ ! -s $f || $bin -nt $f ]]; then "$@" >| $f && zcompile $f || { rm -f $f; return 1 }; fi
  source $f
}

[[ ~/.zshrc.zwc -nt ~/.zshrc ]] || zcompile ~/.zshrc

_zsrc $ZDOTDIR_CFG/options.zsh
_zsrc $ZDOTDIR_CFG/aliases.zsh

# plugins (sheldon): generated script cached; regenerates when plugins.toml changes.
# compinit runs inside it (see plugins.toml).
if (( $+commands[sheldon] )); then
  _sheldon_toml=${XDG_CONFIG_HOME:-~/.config}/sheldon/plugins.toml
  if [[ ! -s $ZCACHE/plugins.zsh || $_sheldon_toml -nt $ZCACHE/plugins.zsh ]]; then
    sheldon source >| $ZCACHE/plugins.zsh && zcompile $ZCACHE/plugins.zsh
  fi
  source $ZCACHE/plugins.zsh
  unset _sheldon_toml
fi

_zcache mise    mise activate zsh
_zcache zoxide  zoxide init zsh --cmd cd
_zcache fzf     fzf --zsh
_zcache starship starship init zsh --print-full-init

_zsrc $ZDOTDIR_CFG/keybinds.zsh
_zsrc $ZDOTDIR_CFG/local.zsh   # untracked machine-specific overrides

unfunction _zsrc _zcache
