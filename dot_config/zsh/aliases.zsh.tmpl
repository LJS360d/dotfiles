# Aliases — add yours here.

# Docker
alias docker-deepclean='docker system prune -a --volumes -f'

# Editor / clipboard
alias zed='zeditor'
alias clip='xclip -selection clipboard'

# Listing & navigation
if (( $+commands[eza] )); then
  alias ls='eza --group-directories-first --icons=auto'
  alias ll='eza -lh --group-directories-first --icons=auto --git'
  alias la='eza -lha --group-directories-first --icons=auto --git'
  alias lt='eza --tree --level=2 --icons=auto'
else
  alias ll='ls -lh --color=auto'
  alias la='ls -lha --color=auto'
fi
alias l='ls -CF --color=auto'
alias ..='cd ..'
alias ...='cd ../..'
(( $+commands[bat] )) && alias cat='bat --paging=never --style=plain'

# Package manager (picked by distro at chezmoi apply)
{{- $distro := list .chezmoi.osRelease.id | concat (splitList " " (.chezmoi.osRelease.idLike | default "")) }}
{{- if has "debian" $distro }}
alias update='sudo apt-get update && sudo apt-get upgrade'
alias install='sudo apt-get install'
alias search='apt-cache search'
alias remove='sudo apt-get remove --autoremove'
alias rmpkg='sudo apt-get purge --autoremove'
alias clean='sudo apt-get autoclean'
alias cleanch='sudo apt-get clean'
{{- else if has "arch" $distro }}
alias update='sudo pacman -Syu'
alias install='sudo pacman -S'
alias search='pacman -Ss'
alias remove='sudo pacman -Rs'
alias rmpkg='sudo pacman -Rsn'
alias clean='sudo pacman -Sc'
alias cleanch='sudo pacman -Scc'
alias fixpacman='sudo rm /var/lib/pacman/db.lck'
{{- end }}
alias jctl='journalctl -p 3 -xb'

# Safety & convenience
alias c='clear'
alias grep='grep --color=auto'
alias cp='cp -iv'
alias mv='mv -iv'
alias rm='rm -i'
alias please='sudo'
alias make="make -j$(nproc)"
alias ninja="ninja -j$(nproc)"
alias n='ninja'

# Modern replacements (only if installed)
(( $+commands[duf] ))   && alias df='duf'
(( $+commands[dust] ))  && alias du='dust'
(( $+commands[procs] )) && alias ps='procs'
(( $+commands[btop] ))  && alias top='btop'
(( $+commands[yazi] ))  && alias y='yazi'
(( $+commands[rg] ))    && alias rgi='rg -i'
(( $+commands[tldr] ))  && alias help='tldr'
