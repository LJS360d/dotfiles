[
  {
    "context": "Terminal",
    "bindings": {
      "shift-enter": [
        "terminal::SendText",
        "\u001b\r"
      ]
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-v": "terminal::Paste"
    }
  },
  {
    "context": "Terminal",
    "unbind": {
      "ctrl-shift-v": "terminal::Paste"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-c": "terminal::Copy"
    }
  },
  {
    "context": "Terminal",
    "unbind": {
      "ctrl-shift-c": "terminal::Copy"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-shift-c": [
        "terminal::SendKeystroke",
        "ctrl-c"
      ]
    }
  },
  {
    "context": "Terminal",
    "unbind": {
      "ctrl-c": [
        "terminal::SendKeystroke",
        "ctrl-c"
      ]
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-;": "editor::ToggleLineNumbers"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-;": "terminal_panel::Toggle"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-`": "terminal_panel::Toggle"
    }
  }
]
